/*----------------------------*/

tw-passage {
    flex-wrap: wrap;
  	
}

tw-passage > div {
    flex-basis: 100%;
  	display: flex;
  	flex-direction: column;
  	align-items: center;
  	gap: 0;
  	margin:-50px;
   
}

/*----------------------------*/


/*Posicionamento dos textos*/

.div-teste {
  	position: fixed;
	display: flex;
    flex-direction: row;
  	gap: 50px;
  
}

/*Estilização do link das primeiras páginas*/

body [tags~="efeitoLink"] tw-link {
	color:white;
  	font-size:20px;
  	border: 2px solid white;
  	border-radius:10px;
  	padding: 10px;
 
}

body [tags~="efeitoLinkVoltar"] tw-link {
	margin-top:190px;
}

/*Links das escolhas*/

body [tags~="escolhas"] tw-link {
	color:white;
  	text-align:justify;
  	height:45px;
  	margin: -20px;

}

body [tags~="pag17escolhas"] tw-link {
	font-size:20px;
}



/*----------------------------*/

body .div-teste tw-passage {margin-top:100%;}

tw-passage [tags~="pag17escolhas"] {
	margin-top: 50%;
}

tw-passage {
    background-image: none !important;
  	display: flex;
    flex-direction: row;
  	flex-wrap: wrap;
  	justify-content: center; /*Novo*/
  	align-content: flex-start;
  	gap: 60px;            /* vertical 10px, horizontal 60px */
    width: 100%;
  	margin: 0; /*a proporção original era de 48vh*/
 	margin-top: 44.8%;
    overflow: hidden;          /* remove a barra de rolação */
  
  	
}
  	
}



tw-passage br {
    display: none;   /*teste para remoção de itens adicionais */
}

tw-expression,
tw-hook {
    display: contents;
}

tw-expression[name="link-goto"][title*="->132"] tw-link { 
  /*Para posicionar o link no lugar correto da tela*/
    position: relative;
    left: -90px;
  
}

.transition-in[data-t8n^=dissolve] {
  -webkit-animation: appear 0ms step-start;
  animation: appear 0ms step-start;
}


/*Alinhamento do texto página 2*/



/*Mudança da cor do texto*/